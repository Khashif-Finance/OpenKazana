# =============================================================================
# OpenKhazana Configuration (.env.example)
# Copy to .env:  cp .env.example .env
# =============================================================================

# --- Deployment Mode ---
# development | production
ENVIRONMENT=development
# local (zero-login personal self-hosted workspace) | multiuser (VPS / Cloud SaaS)
AUTH_MODE=local
# Set to false on a private VPS to block public signups after creating your first admin account
ALLOW_PUBLIC_REGISTRATION=true
RATE_LIMIT_ENABLED=true

# --- Production VPS Domain (used by docker-compose.prod.yml + Caddy auto-HTTPS) ---
APP_DOMAIN=openkhazana.yourdomain.com

# --- Database & Cache ---
POSTGRES_USER=openkhazana
POSTGRES_PASSWORD=openkhazana_dev_pw
POSTGRES_DB=openkhazana
DATABASE_URL=postgresql+asyncpg://openkhazana:openkhazana_dev_pw@postgres:5432/openkhazana
# Local zero-config SQLite alternative:
# DATABASE_URL=sqlite+aiosqlite:///./openkhazana_local.db
REDIS_URL=redis://redis:6379/0

# --- Security & Sessions ---
# REQUIRED in ENVIRONMENT=production: generate with `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-long-random-secret-in-production
# Optional header secret (`X-Admin-Key`) for triggering scrapers / admin APIs from CI or cron
ADMIN_API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# --- Optional Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Optional Alert Dispatchers (Email SMTP & Telegram) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@openkhazana.local
TELEGRAM_BOT_TOKEN=

# --- Market Data Scrapers ---
SCRAPERS_ENABLED=true
SEED_DEMO_ON_EMPTY_DB=false
PSX_INTRADAY_INTERVAL_SECONDS=300

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
